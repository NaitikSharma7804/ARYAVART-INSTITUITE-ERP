# ===============================================
# ARYAVART INSTITUTE ERP - ENVIRONMENT VARIABLES
# ===============================================

# Server Port
PORT=5000

# Database Configuration (Option 1: Individual Connection Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aryavart

# Database Configuration (Option 2: Cloud Database URL like TiDB Cloud / Aiven)
# DATABASE_URL=mysql://user:password@gateway.tidbcloud.com:4000/aryavart?ssl={"rejectUnauthorized":true}

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES=7d

# Google OAuth 2.0 / Sign-in with Google
# Get from: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client IDs -> Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Integration (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=aryavart
